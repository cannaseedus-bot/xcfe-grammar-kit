{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khanary:schema:micronaut-track:1",
  "title": "KHANARY Micronaut Semantic Track",
  "description": "Schema for data/tracks/*.semantic-tracks.v1.json. References shared track types like TypeScript imports.",
  "type": "object",
  "required": ["@no-eval", "id", "phase", "governs"],
  "properties": {
    "@no-eval": { "const": true },
    "id": { "type": "string", "minLength": 1 },
    "schema": { "enum": ["v1", "semantic-tracks.v1", "semantic-tracks.v1.json"] },
    "description": { "type": "string" },
    "phase": { "$ref": "micronaut-track-types.schema.json#/$defs/PhaseName" },
    "category": { "type": "string" },
    "aiml_entropy_coupling": {
      "type": "object",
      "description": "Entropy-coupled delegation. delegate_verb is a RelationVerb (same closed vocabulary as relations[].verb) and is TYPED BUT INERT: typing asserts one thing only — if this field holds a relation verb it must come from the Relation ISA. It implies nothing about runtime use.",
      "properties": {
        "delegate_verb": {
          "$ref": "micronaut-track-types.schema.json#/$defs/RelationVerb"
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "static_weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "health": { "type": "number", "minimum": 0, "maximum": 1 },
    "governs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sub_micronauts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "micronaut-track-types.schema.json#/$defs/RelationEdge" }
    },
    "has_a_hierarchy": {
      "type": "array",
      "items": { "$ref": "micronaut-track-types.schema.json#/$defs/HasARelation" }
    },
    "truth_semantics": {
      "type": "array",
      "items": { "$ref": "micronaut-track-types.schema.json#/$defs/TruthConditionalRule" }
    },
    "qa_profile": {
      "$ref": "micronaut-track-types.schema.json#/$defs/QASemanticsProfile"
    },
    "folds": {
      "type": "array",
      "items": { "$ref": "micronaut-track-types.schema.json#/$defs/FoldEntry" }
    },
    "contrast_sets": {
      "type": "array",
      "items": { "$ref": "micronaut-track-types.schema.json#/$defs/ContrastSet" }
    },
    "sandbox": { "$ref": "micronaut-track-types.schema.json#/$defs/Sandbox" }
  },
  "additionalProperties": true
}
